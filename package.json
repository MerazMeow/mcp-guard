  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerazMeow/mcp-guard.git"
  },
  "homepage": "https://github.com/MerazMeow/mcp-guard#readme",
  "bugs": {
    "url": "https://github.com/MerazMeow/mcp-guard/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "devDependencies": {}
}
